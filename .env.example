# ─── Improzo Signal Engine Configuration ─────────────────────────────────────
# Copy this file to .env and fill in your values.

# Environment
SIGNAL_ENVIRONMENT=development
SIGNAL_DEBUG=true
SIGNAL_LOG_LEVEL=INFO

# Database
SIGNAL_DATABASE__URL=sqlite+aiosqlite:///./signal_engine.db

# Redis (optional - for caching and task queue)
SIGNAL_REDIS__URL=redis://localhost:6379/0

# HubSpot CRM
SIGNAL_HUBSPOT__API_KEY=your-hubspot-private-app-token
SIGNAL_HUBSPOT__PORTAL_ID=your-portal-id

# API
SIGNAL_API__HOST=0.0.0.0
SIGNAL_API__PORT=8000
SIGNAL_API__CORS_ORIGINS=["http://localhost:5173","https://tirthankarray.github.io"]
SIGNAL_API__API_KEY=your-api-key-for-auth

# News API Keys (optional - for NewsAPI scraper)
NEWSAPI_KEY=your-newsapi-key
GNEWS_KEY=your-gnews-key

# Scraper Settings
SIGNAL_SCRAPER__MAX_CONCURRENT_SCRAPERS=5
SIGNAL_SCRAPER__RATE_LIMIT_PER_DOMAIN=1.0
SIGNAL_SCRAPER__PLAYWRIGHT_HEADLESS=true

# NLP Settings
SIGNAL_NLP__SPACY_MODEL=en_core_web_sm
SIGNAL_NLP__EMBEDDING_MODEL=all-MiniLM-L6-v2
SIGNAL_NLP__CLASSIFICATION_THRESHOLD=0.65
SIGNAL_NLP__DEDUP_SIMILARITY_THRESHOLD=0.85

# Scheduler (cron-style)
SIGNAL_SCHEDULER__NEWS_INTERVAL_MINUTES=30
SIGNAL_SCHEDULER__JOBS_INTERVAL_MINUTES=360
SIGNAL_SCHEDULER__REGULATORY_INTERVAL_MINUTES=720
SIGNAL_SCHEDULER__FULL_SCAN_CRON=0 6 * * *
